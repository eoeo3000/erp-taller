# Variables de la PWA Operativa (terreno). Copiar a `.env` y completar.
#
# Vite las hornea EN EL BUILD. Cambiarlas obliga a reconstruir.

# URL base del backend. Sin ella cae a http://localhost:5000/api.
VITE_API_URL=https://tu-backend.onrender.com/api

# OBLIGATORIA si el backend tiene API_KEY definida, y debe ser LA MISMA.
# Esta app guarda contra PUT /api/ots/:id —grabar el informe de evaluación y marcar tareas como
# realizadas—, una de las rutas protegidas. Sin esta clave el backend responde 401 y LOS
# GUARDADOS FALLAN EN SILENCIO: la app muestra el error pero el flujo se ve normal desde afuera.
# Confirmado grabando el video de la demo, donde el informe parecía guardarse y la base no
# recibía nada.
VITE_API_KEY=
