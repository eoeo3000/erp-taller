# Variables de la PWA Cliente. Copiar a `.env` y completar.
#
# Vite las hornea EN EL BUILD. Cambiarlas obliga a reconstruir.

# URL base del backend. Sin ella cae a http://localhost:5000/api.
VITE_API_URL=https://tu-backend.onrender.com/api

# Esta app NO necesita VITE_API_KEY: solo llama rutas de /api/portal, que no están detrás de
# ese gate (se autentica con el token de SesionPortal del cliente).
