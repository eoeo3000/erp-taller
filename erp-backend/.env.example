# Variables del backend. Copiar a `.env` y completar.
#
# Este archivo es la lista de chequeo al dar de alta una instalación nueva: olvidarse una es
# exactamente cómo apareció el bug del VITE_API_KEY faltante, donde los guardados de terreno
# devolvían 401 y el flujo se veía normal desde afuera.
#
# Nada de acá se versiona con valores reales: `.env` está en .gitignore.

# --- Base de datos ---------------------------------------------------------------------
# OBLIGATORIA. Una base por taller (ver docs/plan-multi-taller.md).
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/nombre_de_la_base
# Base de demostración. Sin ella el modo demo queda deshabilitado (avisa por consola).
# El seed `npm run demo:reset` SOLO escribe acá, y aborta si la base no se llama erp_taller_demo.
MONGO_URI_DEMO=mongodb+srv://usuario:clave@cluster.mongodb.net/erp_taller_demo

# --- Servidor -------------------------------------------------------------------------
# Opcional, 5000 por defecto. En Render la define la plataforma.
PORT=5000

# --- Correo (Brevo) -------------------------------------------------------------------
# Cotizaciones, avisos al supervisor, invitaciones de cuenta y recuperación de clave.
BREVO_API_KEY=
EMAIL_FROM=no-responder@tu-dominio.cl

# --- Accesos --------------------------------------------------------------------------
# Activa el login de la SPA de escritorio. OJO CON EL ORDEN AL DESPLEGAR: primero desplegar,
# después crear la cuenta con `node scripts/crearAdmin.js`, y RECIÉN AHÍ poner esto en 'true'.
# Al revés deja a la oficina frente a una pantalla de acceso que nadie puede pasar.
AUTH_REQUERIDA=false
# Cierra /ots y /solicitudes a quien no pruebe quién es: sesión de escritorio (erp-web) o token
# de persona (erp-pwa-operativa). MISMO CUIDADO CON EL ORDEN: primero desplegar el backend,
# después la PWA que manda el token, probarlo en un teléfono de verdad, y recién ahí 'true'.
# Encenderlo antes deja a un supervisor en terreno sin poder guardar su informe.
# Exige AUTH_REQUERIDA='true': sin login el escritorio no manda sesión y recibe 401 en todo.
IDENTIDAD_REQUERIDA=false
# Secreto compartido que protege las rutas de escritura de mayor riesgo. Debe ser DISTINTA por
# instalación. Si se define acá, hay que definir la misma como VITE_API_KEY en erp-web y en
# erp-pwa-operativa, o sus guardados fallan con 401.
API_KEY=

# --- URLs de cada app -----------------------------------------------------------------
# Las usan los correos y los links que se comparten, para apuntar al host de cada app y no al
# del backend. En LOCAL dejarlas sin definir: los defaults de src/config/urls.js ya apuntan a
# localhost con el puerto de cada una.
# EN PRODUCCIÓN SON OBLIGATORIAS: sin ellas, el link que recibe el cliente apunta a localhost.
API_URL=https://tu-backend.onrender.com
SPA_URL=https://tu-erp-web.onrender.com
PWA_OPERATIVA_URL=https://tu-pwa-operativa.onrender.com
PWA_CLIENTE_URL=https://tu-pwa-cliente.onrender.com

# --- Solo para scripts, no para el servidor -------------------------------------------
# `node scripts/crearAdmin.js` — crea la primera cuenta de oficina de una instalación.
# Se pasan en la línea del comando, no conviene dejarlas acá.
#   ADMIN_EMAIL=
#   ADMIN_NOMBRE=
#   ADMIN_PASSWORD=
# `npm run demo:reset` — cuenta de la demostración. Tiene valores por defecto documentados.
#   DEMO_EMAIL=
#   DEMO_PASSWORD=
