# Variables de erp-web (SPA de escritorio). Copiar a `.env` y completar.
#
# OJO: Vite hornea estas variables EN EL BUILD, no las lee en tiempo de ejecución. Cambiarlas
# obliga a reconstruir, y hoy eso significa un build por taller (ver docs/plan-multi-taller.md,
# sección 2: resolverlo es la pieza de mayor retorno del plan).

# URL base del backend. Sin ella cae a http://localhost:5000/api.
VITE_API_URL=https://tu-backend.onrender.com/api

# Debe ser LA MISMA que API_KEY del backend de esta instalación. Si el backend la tiene
# definida y acá falta, las escrituras de mayor riesgo fallan con 401.
# No es autenticación por persona: viaja en el build y se ve en el network tab.
VITE_API_KEY=
